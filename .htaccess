# For XAMPP / Apache
<IfModule mod_php.c>
  php_value upload_max_filesize 4G
  php_value post_max_size 4G
  php_value memory_limit 1024M
  php_value max_execution_time 0
  php_value max_input_time 0
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 4G
  php_value post_max_size 4G
  php_value memory_limit 1024M
  php_value max_execution_time 0
  php_value max_input_time 0
</IfModule>
Options -Indexes
<FilesMatch "^(config\.php|.*\.json)$">
  Require all denied
</FilesMatch>
